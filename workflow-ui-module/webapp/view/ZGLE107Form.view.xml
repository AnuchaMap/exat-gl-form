<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <VBox width="100%" class="sapUiResponsiveMargin">
        <l:Grid defaultSpan="XL6 L6 M6 S12" vSpacing="0" class="sapUiNoContentPadding equalPanelHeight collapsibleHeaderPanel">
            
            <Panel headerText="Header Data" expandable="false" expanded="true" class="contentSectionPanel signaturePanel">
                <headerToolbar>
                    <Toolbar height="2rem">
                        <core:Icon src="sap-icon://accelerated" class="sapUiSmallMarginEnd" />
                        <Title text="Header Data" class="panelTitle" />
                    </Toolbar>
                </headerToolbar>
                <content>
                    <l:Grid defaultSpan="XL6 L6 M6 S12" vSpacing="0" hSpacing="2" class="sapUiMediumPadding">
                        <VBox class="sapUiSmallMarginBottom">
                            <Text text="Request Number" class="labelGrey" />
                            <Text text="{context>/RequestNo}" class="valueBlue" />
                        </VBox>
                        <VBox class="sapUiSmallMarginBottom">
                            <Text text="Request Status" class="labelGrey" />
                            <ObjectStatus id="txtStatus" 
                                          text="{= ${context>/IsReject} ? 'Reject' : (${context>/IsAllApproved} ? 'All Approved' : 'PENDING APPROVAL') }" 
                                          state="{= ${context>/IsReject} ? 'Error' : (${context>/IsAllApproved} ? 'Success' : 'Information') }" />
                        </VBox>
                    </l:Grid>
                </content>
            </Panel>

            <Panel headerText="ผู้จัดทำ / ผู้อนุมัติ" expandable="false" expanded="true" class="contentSectionPanel signaturePanel">
                <headerToolbar>
                    <Toolbar height="2rem">
                        <core:Icon src="sap-icon://account" class="sapUiSmallMarginEnd" />
                        <Title text="ผู้จัดทำ / ผู้อนุมัติ" class="panelTitle" />
                    </Toolbar>
                </headerToolbar>
                <content>
                    <l:Grid defaultSpan="XL6 L6 M6 S12" vSpacing="0" hSpacing="2" class="sapUiMediumPadding">
                        <VBox class="sapUiSmallMarginBottom">
                            <Text text="ผู้จัดทำ" class="labelGrey" />
                            <Text text="{context>/Requester}" class="valueBlue" />
                        </VBox>
                        <VBox class="sapUiSmallMarginBottom">
                            <Text text="ผู้อนุมัติ" class="labelGrey" />
                            <Text text="{context>/Approver}" class="valueBlue" />
                        </VBox>
                    </l:Grid>
                </content>
            </Panel>

        </l:Grid>
         <VBox class="sapUiResponsiveMargin">
            <Panel headerText="Accrual Data" expandable="false" expanded="true" class="contentSectionPanel signaturePanel">
                <headerToolbar>
                    <Toolbar height="2rem">
                        <core:Icon src="sap-icon://document" class="sapUiSmallMarginEnd" />
                        <Title text="Accrual Data" class="panelTitle" />
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiMediumPadding sapUiSmallMarginBegin">
                        <Text text="Terminate Accrual Object No" class="labelGrey" />
                        <Text text="{context>/TransactionData/Accrual/TermiateAccrualObjectNo}" wrapping="true" class="valueBlue sapUiSmallMarginBottom" />

                        <Text text="Deactivate Date" class="labelGrey" />
                        <Text text="{context>/TransactionData/Accrual/DeactivateDate}" class="valueBlue sapUiSmallMarginBottom" />
                    </VBox>

                    <ScrollContainer height="300px" vertical="true" width="100%">
                        <Table items="{context>/TransactionData/Accrual/AccrualObject}" class="customTable smallFontTable" inset="false" width="100%">
                            <columns>
                                <Column hAlign="Begin" width="12%"><Text text="Accrual Object No" wrapping="false" /></Column>
                                <Column hAlign="Begin" width="9%"><Text text="Account" wrapping="false" /></Column>
                                <Column hAlign="Begin" width="20%"><Text text="Description" wrapping="false" /></Column>
                                <Column hAlign="Begin" width="9%"><Text text="Accr. Acc" wrapping="false" /></Column>
                                <Column hAlign="Begin" width="20%"><Text text="Description" wrapping="false" /></Column>
                                <Column hAlign="Begin" width="10%"><Text text="Start Date" wrapping="false" /></Column>
                                <Column hAlign="Begin" width="10%"><Text text="End Date" wrapping="false" /></Column>
                                <Column hAlign="End" width="10%"><Text text="Amount" wrapping="false" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active" vAlign="Middle">
                                    <cells>
                                        <Text text="{context>AccrualObjectNo}" class="valueDark" wrapping="false" />
                                        <Text text="{context>Account}" class="valueDark" wrapping="false" />
                                        <Text text="{context>Description}" class="valueDark" wrapping="false" />
                                        <Text text="{context>AccrAcc}" class="valueDark" wrapping="false" />
                                        <Text text="{context>AccrAccDescription}" class="valueDark" wrapping="false" />
                                        <Text text="{context>StartDt}" class="valueDark" wrapping="false" />
                                        <Text text="{context>EndDt}" class="valueDark" wrapping="false" />
                                        <Text text="{context>Amount}" class="valueDark" wrapping="false" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </ScrollContainer>

                    <VBox class="sapUiMediumPadding sapUiSmallMarginBegin">
                        <Text text="Reason" class="labelGrey" />
                        <Text text="{context>/TransactionData/Accrual/Reason}" class="valueBlue" />
                    </VBox>
                </content>
            </Panel>
        </VBox>
    </VBox>
</mvc:View>
